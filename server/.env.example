PORT=5000

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=30000
AGENT_MAX_TURNS=12

# Comma-separated origins allowed to call the API
CLIENT_ORIGIN=http://localhost:5173
# Linked from calendar events and the digest email
APP_URL=http://localhost:5173

# Defaults; each can be changed in Settings.
# About you: used in the assistant's prompt and to sign outreach drafts
USER_NAME=Mit
USER_PITCH=

# Every date you mention is read in this timezone
APP_TIMEZONE=America/Toronto
FOLLOW_UP_DAYS=7
# Local hour (0-23) when follow-ups and revisions come due, the digest is sent, and the evening nudge fires
REMINDER_HOUR=9
DIGEST_HOUR=9
NUDGE_HOUR=20

# SQLite file (defaults to server/data/copilot.db)
# DB_PATH=

# Optional Google connections (Calendar, Gmail). Create an OAuth client of type
# "Web application" with this redirect URI, then connect services in Settings.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback
GOOGLE_CALENDAR_ID=primary

# Encrypts stored Google tokens. Leave empty to generate one into server/data/secret.key
APP_SECRET=

# There is no sign-in, so the server only listens on this computer ("loopback").
# Set HOST=0.0.0.0 only behind something that does its own sign-in, and list the
# host names it is reached by in ALLOWED_HOSTS (comma-separated).
HOST=loopback
ALLOWED_HOSTS=
